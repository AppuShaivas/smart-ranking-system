# ------------------------------------------------------------------
# Copy this file, rename the copy to ".env" and fill in your values.
# ------------------------------------------------------------------

# Your MongoDB Atlas connection string.
# IMPORTANT: put the database name "ssars" between ".net/" and "?"
# Example: mongodb+srv://myuser:mypassword@cluster0.abcde.mongodb.net/ssars?retryWrites=true&w=majority
MONGO_URI=

# Any long random sentence. Used to sign login tokens. Keep it secret.
JWT_SECRET=change-this-to-a-long-random-sentence-12345

# Code required to register an Administrator account.
ADMIN_CODE=ADMIN2026

# Port the backend runs on (leave as 5000).
PORT=5000
